# ローカル用。このファイルを media.env にコピーしてパスを書く（media.env は git 管理しない）。
#   cp local/media.env.example local/media.env

# 背景（画像または動画）。未使用なら空のまま。
MANIM_BG_PATH=/absolute/path/to/background.png

# BGM（mp3 / wav / m4a など）。未使用なら空のまま。
MANIM_BGM_PATH=/absolute/path/to/bgm.mp3

# 任意
# MANIM_MEDIA_ROOT=/Volumes/T7/manim_media/videos
# MANIM_BGM_VOLUME=0.18
# MANIM_BGM_FADE=2
# MANIM_BG_MODE=colorkey
# MANIM_COLORKEY=000000
# MANIM_COLORKEY_SIMILARITY=0.10
# MANIM_MUX_OUTPUT=
